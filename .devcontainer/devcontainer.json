{
  "name": "Aplicaciones Web: PHP + MariaDB",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash .devcontainer/instalar-entorno.sh",
  "postStartCommand": "bash .devcontainer/iniciar-mariadb.sh",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Aplicación" },
    "8080": { "label": "Adminer (administrador de la base)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  }
}
